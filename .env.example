# ---- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (Supabase / Neon / Railway / local). Set DATABASE_SSL=true for hosted DBs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grant_radar
DATABASE_SSL=false

# Public URL of the Next.js app and the Fastify API.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Only needed when web and api are on different subdomains (e.g. .example.com).
# COOKIE_DOMAIN=

# ---- Auth (passwordless magic links) ---------------------------------------
# >= 32 chars. Used to HMAC magic-link and session tokens at rest.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15

# ---- Email ------------------------------------------------------------------
# console = print emails to the log (dev). resend = send via Resend.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Grant Radar <alerts@yourdomain.com>"

# ---- Stripe -----------------------------------------------------------------
# Single $29/month recurring price with a 7-day trial (card required up front).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
TRIAL_DAYS=7

# ---- Worker -----------------------------------------------------------------
# Cron expressions (UTC). Daily ingestion at 06:00, digests at 13:00.
INGEST_CRON=0 6 * * *
DIGEST_CRON=0 13 * * *
INGEST_MAX_PER_SOURCE=500
# Optional override for apps/api/config/sources.json
# SOURCES_FILE=
# Optional bearer token to trigger POST /jobs/ingest and /jobs/digest manually.
CRON_SECRET=
